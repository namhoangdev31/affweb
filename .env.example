# Core feature flags (enabled for local/dev testing)
TENANT_IMPORT_ENABLED=true
SAAS_BILLING_ENABLED=false
MASTER_TENANT_ID=
TENANT_FINANCE_ENABLED=true
TENANT_TOPUP_ENABLED=true
TENANT_AUTO_PAYOUT_ENABLED=true
ZALO_BOT_ENABLED=false

# Hierarchical finance safety limits (fail-closed defaults)
PLATFORM_SELF_APPROVAL_LIMIT_VND=0
MANUAL_NO_SEND_SELF_CONFIRM_LIMIT_VND=0
FINANCE_RECONCILIATION_DELAYS_SECONDS=60,300,900,3600
FINANCE_SWEEP_BATCH_SIZE=100
FINANCE_APPROVED_STALE_MINUTES=10
FINANCE_PROCESSING_STALE_MINUTES=15
FINANCE_UNKNOWN_SLA_MINUTES=240
FINANCE_RESERVATION_STALE_MINUTES=1440

# Central Zalo Bot
ZALO_BOT_TOKEN=
ZALO_BOT_SECRET_TOKEN=
ZALO_DATA_ENCRYPTION_KEY_V1=
NEXT_PUBLIC_ZALO_BOT_PROFILE_URL=
NEXT_PUBLIC_ZALO_BOT_GROUP_INVITE_URL=

# Shopee & ShopeeFood (an_redir + AddLiveTag)

# Application & Core
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BUILD_SHA=development
NODE_ENV=development
REGISTRATION_MODE=public

# Database (Neon PostgreSQL)
DATABASE_URL=
DIRECT_URL=
DATABASE_URL_UNPOOLED=

# CI/integration only. Never point these at development, preview or production.
TEST_DATABASE_URL=
TEST_DIRECT_URL=
TEST_DATABASE_HOST_ALLOWLIST=
ALLOW_TEST_DATABASE_RESET=false

# Clerk identity (Configure manually in Vercel project aff for app_3GxTUr7hRQ5aU7hJX2kz7DWGu6U)
CLERK_APPLICATION_ID=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

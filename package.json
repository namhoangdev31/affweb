{
  "name": "affweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": "22.x",
    "pnpm": "10.5.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "tsx scripts/run-disposable-integration.ts",
    "test:integration:concurrency": "tsx scripts/run-disposable-integration.ts tests/integration/payout-concurrency.test.ts",
    "db:test:check": "tsx scripts/check-disposable-test-db.ts",
    "test:run": "pnpm test:unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm db:validate && pnpm test:unit && pnpm build",
    "env:check": "tsx scripts/check-env.ts",
    "jobs:setup": "tsx scripts/setup-qstash.ts",
    "clerk:bootstrap-admin": "tsx scripts/bootstrap-super-admin.ts",
    "tenant:configure-master": "tsx scripts/configure-master-tenant.ts",
    "finance:inventory-legacy": "tsx scripts/inventory-legacy-finance.ts",
    "pwa:screenshots": "tsx scripts/capture-pwa-screenshots.ts",
    "smoke:production": "tsx scripts/smoke-production.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1094.0",
    "@aws-sdk/client-sts": "3.1094.0",
    "@clerk/nextjs": "7.6.0",
    "@payos/node": "2.0.5",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sentry/nextjs": "10.69.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "@upstash/qstash": "2.11.3",
    "@upstash/redis": "1.38.0",
    "@vercel/oidc": "3.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "16.6.1",
    "lossless-json": "4.3.0",
    "lucide-react": "1.26.0",
    "next": "16.2.11",
    "pg": "8.22.0",
    "radix-ui": "1.6.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@clerk/testing": "2.2.12",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "fast-check": "4.9.0",
    "jsdom": "28.1.0",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "sharp": "0.35.0",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "fast-uri": "3.1.5"
    }
  }
}

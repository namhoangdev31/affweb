{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "src/app/api/internal/jobs/[jobName]/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/internal/jobs/sync-conversions",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/internal/jobs/connector-health",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/internal/jobs/saas-lifecycle",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/jobs/zalo-dispatch",
      "schedule": "0 4 * * *"
    }
  ]
}
